<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml
    Uygulama manifest dosyası: aktiviteler, izinler ve uygulama sınıfı tanımları
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">


    <application
        android:name=".SatinalmaApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/tekinflow_mark"
        android:label="@string/app_name"

        android:roundIcon="@drawable/tekinflow_mark"
        android:supportsRtl="false"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.SatinalmaApp">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.SatinalmaApp">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>
</manifest>
