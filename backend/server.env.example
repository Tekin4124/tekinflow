KTOR_HOST=127.0.0.1
KTOR_PORT=3099
APP_ENV=dev
DB_URL=jdbc:postgresql://127.0.0.1:5432/tekinflow
DB_USER=your-database-user
DB_PASSWORD=your-private-database-password
JWT_SECRET=replace-with-your-own-random-secret-at-least-32-bytes
ADMIN_INITIAL_PASSWORD=replace-with-your-own-initial-password
SEED_DEMO_USERS=false
SEED_DEMO_REQUESTS=false
# Optional: FIREBASE_CREDENTIALS_PATH to your own account, never a checked-in key.
# Generate with: openssl rand -base64 32; keep this key outside the DB/backups.
TOTP_ENCRYPTION_KEY=your-own-base64-encoded-32-byte-key
